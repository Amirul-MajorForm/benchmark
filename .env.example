# Two Minute Reports REST API (Settings -> API keys, intended use "API", scope data:read)
TMR_API_KEY=
TMR_TEAM_ID=019d0ca3-ce95-7387-a650-5e055605107a
# Confirm with `npm run tmr:probe` and set to the path it reports
TMR_API_BASE=https://api.twominutereports.com/v1
TMR_QUERY_PATH=/teams/{teamId}/query

# Railway Postgres
DATABASE_URL=

# Auth.js (Google sign-in restricted to ALLOWED_EMAIL_DOMAIN)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL_DOMAIN=majorform.co
ADMIN_EMAILS=amirul@majorform.co

# Optional v1 fallback when Google is not configured yet
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
